{%- liquid
  assign raw_name = itemName
  if itemName contains '[' and itemName contains ']'
    assign raw_name = itemName | split: '[' | first
  endif
  assign clean_name = raw_name | strip
  assign name_dn = clean_name | downcase
  
  case name_dn
    when 'what are nanofibres' or 'what are nanofibers' or 'ce sunt nanofibrele'
      echo 'WHAT ARE NANOFIBERS'
    when 'technology and formula' or 'technology & formula' or 'tehnologie si formula' or 'tehnologie si formula'
      echo 'TECHNOLOGY & FORMULA'
    when 'how to use' or 'mod de utilizare'
      echo 'HOW TO USE'
    when 'ritual synergies' or 'sinergii de ritual'
      echo 'RITUAL SYNERGIES'
    when 'scientific foundation and awards' or 'scientific foundation & awards' or 'scientific foundation' or 'baza stiintifica si premii' or 'baza stiintifica si premii'
      echo 'SCIENTIFIC FOUNDATION & AWARDS'
    when 'conversations' or 'conversatii' or 'conversatii'
      echo 'Conversations'
    when 'articles' or 'articole'
      echo 'Articles'
    when 'blog'
      echo 'Blog'
    when 'journal' or 'jurnal'
      echo 'Journal'
    when 'films' or 'film' or 'filme'
      echo 'Films'
    when 'gallery' or 'galerie'
      echo 'Gallery'
    when 'follow lumina' or 'urmareste lumina' or 'urmareste lumina'
      echo 'Follow Lumina'
    when 'meet the team' or 'echipa noastra' or 'echipa noastra'
      echo 'Meet the Team'
    when 'about' or 'about us' or 'despre noi'
      echo 'About Us'
    when 'contact' or 'contact us' or 'contacteaza-ne' or 'contacteaza-ne'
      echo 'Contact Us'
    when 'faq' or 'faqs' or 'intrebari frecvente' or 'intrebari frecvente'
      echo 'FAQs'
    when 'shipping policy' or 'politica de livrare'
      echo 'Shipping Policy'
    when 'returns' or 'return policy' or 'politica de retur'
      echo 'Return Policy'
    when 'terms' or 'terms of service' or 'terms and conditions' or 'termeni si conditii' or 'termeni si conditii'
      echo 'Terms and Conditions'
    when 'privacy policy' or 'politica de confidentialitate' or 'politica de confidentialitate'
      echo 'Privacy Policy'
    when 'all products' or 'toate produsele'
      echo 'All Products'
    when 'home' or 'acasa' or 'acasa'
      echo 'Home'
    else
      echo clean_name | escape
  endcase
-%}