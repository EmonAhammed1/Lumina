{% render 'golden-hour-vars' %}
<style>
  #shopify-section-{{ section.id }} .tm-hero-wrap {
    position: relative;
    width: 100%;
    min-height: 85vh;
    display: flex;
    align-items: center;
    padding: 80px 24px;
    background-color: #000;
    overflow: hidden;
  }
  .tm-hero-bg {
    position: absolute;
    inset: 0;
    z-index: 1;
    display: flex;
    justify-content: flex-end;
    align-items: center;
  }
  .tm-hero-bg img,
  .tm-hero-bg video {
    width: 60%;
    height: 100%;
    object-fit: contain;
    mix-blend-mode: screen;
    opacity: 0.8;
  }
  @media screen and (max-width: 768px) {
    .tm-hero-bg img,
    .tm-hero-bg video {
      width: 100%;
      height: 60%;
      align-self: flex-end;
    }
  }
  .tm-hero-overlay {
    position: absolute;
    inset: 0;
    background: radial-gradient(circle at right center, transparent 0%, #000 80%);
    z-index: 2;
  }
  .tm-hero-content {
    position: relative;
    z-index: 3;
    max-width: 600px;
    width: 100%;
    margin-left: 8%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }
  .tm-hero-subtitle {
    font-size: 13px;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--gh-text-muted);
    margin-bottom: 16px;
    font-family: sans-serif;
  }
  .tm-hero-title {
    font-size: clamp(3rem, 6vw, 5.5rem);
    line-height: 1.05;
    font-weight: 300;
    color: var(--gh-golden);
    margin-bottom: 24px;
    font-family: serif;
    text-transform: uppercase;
  }
  .tm-hero-desc {
    font-size: 16px;
    line-height: 1.6;
    color: var(--gh-text-light);
    margin-bottom: 40px;
    max-width: 450px;
  }
  .tm-hero-btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 14px 32px;
    background-color: #F9D633;
    border: 1px solid #F9D633;
    color: #000;
    text-transform: uppercase;
    font-size: 12px;
    letter-spacing: 0.15em;
    text-decoration: none;
    transition: all 0.3s ease;
    gap: 8px;
  }
  .tm-hero-btn:hover {
    background-color: #000;
    border-color: #F9D633;
    color: #F9D633;
  }
  .tm-hero-btn svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
  }
</style>

<div id="{{ section.id | split: '__' | last }}" class="tm-hero-wrap">
  <div class="tm-hero-bg">
    {% if section.settings.bg_video != blank %}
      {{ section.settings.bg_video | video_tag: autoplay: true, loop: true, muted: true, controls: false, playsinline: true }}
    {% elsif section.settings.bg_image != blank %}
      <img src="{{ section.settings.bg_image | image_url: width: 1200 }}" alt="Hero Graphic">
    {% else %}
      <svg viewBox="0 0 100 100" fill="none" stroke="var(--gh-golden)" style="width: 50%; opacity: 0.3; margin-right: 10%;">
        <circle cx="50" cy="50" r="45"/>
      </svg>
    {% endif %}
  </div>
  <div class="tm-hero-overlay"></div>
  <div class="tm-hero-content">
    {% if section.settings.subtitle != blank %}
      <div class="tm-hero-subtitle">{{ section.settings.subtitle }}</div>
    {% endif %}
    {% if section.settings.title != blank %}
      <h1 class="tm-hero-title">{{ section.settings.title | newline_to_br }}</h1>
    {% endif %}
    {% if section.settings.text != blank %}
      <div class="tm-hero-desc">{{ section.settings.text }}</div>
    {% endif %}
    {% if section.settings.btn_label != blank %}
      <a href="{{ section.settings.btn_link | default: '#' }}" class="tm-hero-btn">
        {{ section.settings.btn_label }}
        <svg viewBox="0 0 24 24"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
      </a>
    {% endif %}
  </div>
</div>

{% schema %}
{
  "name": "Mockup - Hero",
  "settings": [
    {
      "type": "video",
      "id": "bg_video",
      "label": "Background Video"
    },
    {
      "type": "image_picker",
      "id": "bg_image",
      "label": "Background Image (Fallback)"
    },
    {
      "type": "range",
      "id": "overlay_opacity",
      "label": "Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 30
    },
    {
      "type": "text",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "WHERE SCIENCE"
    },
    {
      "type": "textarea",
      "id": "title",
      "label": "Title",
      "default": "BECOMES\nRITUAL"
    },
    {
      "type": "textarea",
      "id": "text",
      "label": "Description",
      "default": "Lumina nanofibre technology delivers encapsulated actives with precision, purity and purpose."
    },
    {
      "type": "text",
      "id": "btn_label",
      "label": "Button Label",
      "default": "EXPLORE THE TECHNOLOGY"
    },
    {
      "type": "url",
      "id": "btn_link",
      "label": "Button Link"
    }
  ],
  "presets": [
    {
      "name": "Mockup - Hero"
    }
  ]
}
{% endschema %}
