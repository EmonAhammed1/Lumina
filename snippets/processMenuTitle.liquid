{%- liquid
  assign raw_name = itemName
  if itemName contains '[' and itemName contains ']'
    assign raw_name = itemName | split: '[' | first
  endif
  assign clean_name = raw_name | strip
  assign name_dn = clean_name | downcase
  
  case name_dn
    # Column & Section Headings
    when 'descoperă lumina' or 'descopera lumina' or 'discover lumina'
      echo 'DISCOVER LUMINA'
    when 'colecții & ritualuri' or 'colectii & ritualuri' or 'collections & rituals' or 'colectii si ritualuri' or 'colecții și ritualuri'
      echo 'COLLECTIONS & RITUALS'
    when 'ajutor & concierge' or 'ajutor si concierge' or 'ajutor' or 'help & concierge' or 'help and concierge' or 'asistență' or 'asistenta'
      echo 'HELP & CONCIERGE'
    when 'legal' or 'termeni legali'
      echo 'LEGAL'
    when 'produse' or 'products'
      echo 'PRODUCTS'
    when 'ritualuri' or 'rituals'
      echo 'RITUALS'
    when 'lumea lumina' or 'lumina world'
      echo 'LUMINA WORLD'

    # Tech & Science
    when 'what are nanofibres' or 'what are nanofibers' or 'ce sunt nanofibrele' or 'ce sunt nanofibrele?'
      echo 'WHAT ARE NANOFIBERS'
    when 'technology and formula' or 'technology & formula' or 'tehnologie și formulă' or 'tehnologie si formula' or 'tehnologie și formula' or 'tehnologie' or 'tehnologia nanofibrelor' or 'nanofiber technology'
      echo 'TECHNOLOGY & FORMULA'
    when 'how to use' or 'how to use it' or 'mod de utilizare' or 'cum se folosește' or 'cum se foloseste' or 'cum se utilizeaza' or 'ghid de utilizare'
      echo 'HOW TO USE'
    when 'ritual synergies' or 'sinergii de ritual' or 'sinergii'
      echo 'RITUAL SYNERGIES'
    when 'scientific foundation and awards' or 'scientific foundation & awards' or 'scientific foundation' or 'bază științifică și premii' or 'baza stiintifica si premii' or 'baza stiintifica' or 'bază științifică'
      echo 'SCIENTIFIC FOUNDATION & AWARDS'
    when 'active ingredients' or 'ingrediente active' or 'ingrediente'
      echo 'Active Ingredients'

    # Lumina World Subpages
    when 'conversations' or 'conversații' or 'conversatii'
      echo 'Conversations'
    when 'articles' or 'articole'
      echo 'Articles'
    when 'blog' or 'stiri' or 'știri' or 'news'
      echo 'Blog'
    when 'journal' or 'jurnal' or 'jurnalul lumina'
      echo 'Journal'
    when 'films' or 'film' or 'filme' or 'video' or 'videoclipuri'
      echo 'Films'
    when 'gallery' or 'galerie' or 'galerie foto'
      echo 'Gallery'
    when 'follow lumina' or 'urmărește lumina' or 'urmareste lumina'
      echo 'Follow Lumina'
    when 'lumina golden hour' or 'golden hour' or 'ora de aur'
      echo 'Lumina Golden Hour'

    # Products & Collections
    when 'collections' or 'colectii' or 'colecții' or 'colectie' or 'colecție' or 'toate colecțiile' or 'toate colectiile'
      echo 'Collections'
    when 'all products' or 'toate produsele' or 'toate produsele lumina' or 'vezi toate produsele'
      echo 'All Products'
    when 'masks with nanofibers' or 'nanofiber masks' or 'măști cu nanofibre' or 'masti cu nanofibre' or 'măști' or 'masti' or 'colectie masti' or 'colecție măști'
      echo 'Nanofiber Masks'
    when 'face sprays' or 'sprayuri pentru față' or 'sprayuri pentru fata' or 'sprayuri' or 'spray de fata' or 'hydro mist'
      echo 'Face Sprays'
    when 'sets & protocols' or 'seturi & protocoale' or 'seturi si protocoale' or 'seturi' or 'protocoale' or 'bundles'
      echo 'Sets & Protocols'
    when 'bestsellers' or 'bestsellere' or 'cele mai vandute' or 'cele mai vândute'
      echo 'Best Sellers'
    when 'new arrivals' or 'noutăți' or 'noutati'
      echo 'New Arrivals'

    # Rituals
    when 'morning ritual' or 'ritualul de dimineață' or 'ritualul de dimineata' or 'ritual de dimineata' or 'ritual de dimineață'
      echo 'Morning Ritual'
    when 'evening ritual' or 'ritualul de seară' or 'ritualul de seara' or 'ritual de seara' or 'ritual de seară'
      echo 'Evening Ritual'
    when 'express ritual' or 'ritual rapid' or 'ritualul rapid'
      echo 'Express Ritual'
    when 'seasonal rituals' or 'ritualuri sezoniere'
      echo 'Seasonal Rituals'

    # Account & Help
    when 'my account' or 'contul meu' or 'cont' or 'profil'
      echo 'My Account'
    when 'my orders' or 'comenzile mele' or 'comenzi' or 'istoric comenzi'
      echo 'My Orders'
    when 'returns' or 'returns & refunds' or 'retururi' or 'retur' or 'politica de retur' or 'formular de retur' or 'politica de retur și rambursare' or 'politica de retur si rambursare'
      echo 'Returns & Refunds'
    when 'shipping' or 'shipping & delivery' or 'shipping policy' or 'livrare' or 'politica de livrare' or 'livrare si plata' or 'livrare & plata'
      echo 'Shipping Policy'
    when 'faq' or 'faqs' or 'întrebări frecvente' or 'intrebari frecvente' or 'intrebari' or 'intrebari si raspunsuri' or 'întrebări și răspunsuri'
      echo 'Frequently Asked Questions'
    when 'contact' or 'contact us' or 'contactează-ne' or 'contacteaza-ne' or 'contactati-ne' or 'contactați-ne'
      echo 'Contact Us'

    # Legal & Company
    when 'about' or 'about us' or 'about lumina europa' or 'despre noi' or 'despre lumina europa' or 'despre lumina' or 'despre'
      echo 'About Lumina Europa'
    when 'meet the team' or 'our team' or 'echipa noastră' or 'echipa noastra' or 'echipa' or 'the team'
      echo 'Our Team'
    when 'terms' or 'terms of service' or 'terms and conditions' or 'termeni și condiții' or 'termeni si conditii' or 'termeni' or 'termeni si conditii de utilizare'
      echo 'Terms and Conditions'
    when 'privacy policy' or 'politica de confidențialitate' or 'politica de confidentialitate' or 'confidentialitate' or 'protectia datelor'
      echo 'Privacy Policy'
    when 'cookie policy' or 'politica cookies' or 'cookies' or 'politica de cookie' or 'politica privind fisierele cookies'
      echo 'Cookie Policy'
    when 'anpc' or 'anpc.ro' or 'protectia consumatorului' or 'protectia consumatorilor'
      echo 'Consumer Protection (ANPC)'
    when 'anpc - sal' or 'sal' or 'soluționarea alternativă a litigiilor' or 'solutionarea alternativa a litigiilor'
      echo 'Alternative Dispute Resolution (SAL)'
    when 'anpc - sol' or 'sol' or 'soluționarea online a litigiilor' or 'solutionarea online a litigiilor'
      echo 'Online Dispute Resolution (SOL)'
    when 'sustainability' or 'sustenabilitate'
      echo 'Sustainability'
    when 'careers' or 'cariere' or 'carieră' or 'cariera'
      echo 'Careers'
    when 'home' or 'acasă' or 'acasa'
      echo 'Home'
    when 'lumina europa'
      echo 'LUMINA EUROPA'
    when 'collection' or 'colectie' or 'colecție'
      echo 'COLLECTION'
    when 'technology' or 'tehnologie'
      echo 'TECHNOLOGY'
    else
      echo clean_name | escape
  endcase
-%}