{% render 'golden-hour-vars' %}
{%- style -%}
  #shopify-section-{{ section.id }} .gh-benefits-wrap {
    background-color: var(--gh-dark-bg);
    {% if section.settings.background_image_desktop %}
      background-image: url('{{ section.settings.background_image_desktop | image_url: width: 2000 }}');
      background-size: cover;
      background-position: center;
    {% endif %}
    color: var(--gh-text-light);
    padding: {{ section.settings.padding_top_desktop }}px 24px {{ section.settings.padding_bottom_desktop }}px;
    position: relative;
    overflow: hidden;
    max-width: {{ section.settings.max_width }}px;
    margin: 0 auto;
  }
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .gh-benefits-wrap {
      padding: {{ section.settings.padding_top_mobile }}px 16px {{ section.settings.padding_bottom_mobile }}px;
      {% if section.settings.background_image_mobile %}
        background-image: url('{{ section.settings.background_image_mobile | image_url: width: 1000 }}');
        background-size: cover;
        background-position: center;
      {% endif %}
    }
  }
  .gh-benefits-header {
    text-align: center;
    max-width: 800px;
    margin: 0 auto 60px;
  }
  .gh-benefits-title-small {
    font-size: 11px;
    letter-spacing: 0.15em;
    color: var(--gh-text-muted);
    text-transform: uppercase;
    margin-bottom: 20px;
  }
  .gh-benefits-title {
    font-size: {{ section.settings.title_size_desktop }}px;
    color: var(--gh-golden);
    margin-bottom: 16px;
    font-weight: 300;
    font-family: serif;
  }
  @media screen and (max-width: 1024px) {
    .gh-benefits-title {
      font-size: calc({{ section.settings.title_size_desktop }}px * 0.85);
    }
  }
  @media screen and (max-width: 768px) {
    .gh-benefits-title {
      font-size: {{ section.settings.title_size_mobile }}px;
    }
  }
  .gh-benefits-grid {
    display: grid;
    grid-template-columns: repeat(8, 1fr);
    gap: {{ section.settings.grid_gap_desktop }}px;
    max-width: 100%;
    margin: 0 auto 40px;
  }
  @media screen and (max-width: 1400px) {
    .gh-benefits-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }
  @media screen and (max-width: 768px) {
    .gh-benefits-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: {{ section.settings.grid_gap_mobile }}px;
    }
  }
  @media screen and (max-width: 480px) {
    .gh-benefits-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }
  .gh-benefit-card {
    background: transparent;
    border: 1px solid rgba(255,255,255,0.08);
    border-radius: 6px;
    padding: {{ section.settings.card_padding_desktop }}px;
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    transition: var(--gh-transition);
    height: auto;
  }
  .gh-benefit-card:hover {
    background: rgba(255,255,255,0.02);
    border-color: var(--gh-border-gold);
  }
  .gh-card-index {
    font-size: 10px;
    letter-spacing: 0.1em;
    color: var(--gh-text-muted);
    margin-bottom: 12px;
  }
  .gh-card-icon {
    width: {{ section.settings.icon_size_desktop }}px;
    height: {{ section.settings.icon_size_desktop }}px;
    margin-bottom: 14px;
    color: var(--gh-golden);
  }
  .gh-card-icon svg {
    width: 100%;
    height: 100%;
    stroke: currentColor;
    stroke-width: 1;
    fill: none;
  }
  .gh-card-title {
    font-size: {{ section.settings.card_title_size_desktop }}px;
    font-weight: 400;
    color: var(--gh-golden);
    margin-bottom: 10px;
    font-family: serif;
    line-height: 1.3;
  }
  .gh-card-desc {
    font-size: {{ section.settings.card_desc_size_desktop }}px;
    line-height: 1.5;
    color: var(--gh-text-muted);
  }
  @media screen and (max-width: 1024px) {
    .gh-benefit-card {
      padding: calc({{ section.settings.card_padding_desktop }}px * 0.8);
    }
    .gh-card-icon {
      width: calc({{ section.settings.icon_size_desktop }}px * 0.85);
      height: calc({{ section.settings.icon_size_desktop }}px * 0.85);
    }
    .gh-card-title {
      font-size: calc({{ section.settings.card_title_size_desktop }}px * 0.9);
    }
    .gh-card-desc {
      font-size: calc({{ section.settings.card_desc_size_desktop }}px * 0.9);
    }
  }
  @media screen and (max-width: 768px) {
    .gh-benefit-card {
      padding: {{ section.settings.card_padding_mobile }}px;
      height: auto;
    }
    .gh-card-icon {
      width: {{ section.settings.icon_size_mobile }}px;
      height: {{ section.settings.icon_size_mobile }}px;
    }
    .gh-card-title {
      font-size: {{ section.settings.card_title_size_mobile }}px;
    }
    .gh-card-desc {
      font-size: {{ section.settings.card_desc_size_mobile }}px;
    }
  }
{%- endstyle -%}

<div class="gh-benefits-wrap" id="{{ section.id | split: '__' | last }}" data-section-id="{{ section.id }}">
  <div class="gh-benefits-header">
    <div class="gh-benefits-title-small">BENEFICII PENTRU MEMBRII GOLDEN HOUR</div>
    <h2 class="gh-benefits-title">{{ section.settings.heading }}</h2>
  </div>

  <div class="gh-benefits-grid">
    {%- for block in section.blocks -%}
      <div class="gh-benefit-card" {{ block.shopify_attributes }}>

        <h3 class="gh-card-title">{{ block.settings.title }}</h3>
        <p class="gh-card-desc">{{ block.settings.description }}</p>
      </div>
    {%- endfor -%}
  </div>
</div>

