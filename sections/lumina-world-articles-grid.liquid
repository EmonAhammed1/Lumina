          "settings": {
            "category": "CULTURĂ",
            "date": "5 MAI 2025",
            "title": "Orașe atemporale, frumusețe fără vârstă",
            "excerpt": "Ce ne învață orașele europene despre frumusețe, patrimoniu și timp."
          }
        },
        {
          "type": "article_card",
          "settings": {
            "category": "OAMENI",
            "date": "28 APRILIE 2025",
            "title": "Vocile unei noi generații",
            "excerpt": "Tineri europeni despre identitate, scop și viitor."
          }
        },
        {
          "type": "article_card",
          "settings": {
            "category": "SUSTENABILITATE",
            "date": "20 APRILIE 2025",
            "title": "Frumusețe și responsabilitate",
            "excerpt": "De ce luxul autentic respectă lumea din care provenim."
          }
